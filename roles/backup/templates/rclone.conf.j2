# Rclone configuration for S3 backup storage

[{{ backup_s3_remote_name }}]
type = s3
provider = {{ backup_s3_provider | default('Other') }}
access_key_id = {{ backup_s3_access_key }}
secret_access_key = {{ backup_s3_secret_key }}
endpoint = {{ backup_s3_endpoint }}
region = {{ backup_s3_region | default('us-east-1') }}
acl = private
server_side_encryption = {{ backup_s3_encryption | default('AES256') }}
storage_class = {{ backup_s3_storage_class | default('STANDARD') }}

# Performance tuning
chunk_size = 64M
upload_concurrency = 4
