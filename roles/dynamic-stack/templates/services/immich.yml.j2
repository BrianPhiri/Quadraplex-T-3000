immich_server:
  container_name: immich_server
  image: ghcr.io/immich-app/immich-server:{{ services.immich.version }}
  # extends:
  #   file: hwaccel.transcoding.yml
  #   service: cpu # set to one of [nvenc, quicksync, rkmpp, vaapi, vaapi-wsl] for accelerated transcoding
  volumes:
    - {{ stack_config.media_path }}/photos:/data
    - /etc/localtime:/etc/localtime:ro
  environment:
    - PUID={{ stack_config.user_id }}
    - PGID={{ stack_config.group_id }}
    - TZ={{ stack_config.timezone }}
    - DB_PASSWORD={{ services.immich.db.password }}
    - DB_USERNAME={{ services.immich.db.user }}
    - DB_DATABASE_NAME={{ services.immich.db.name | default('immich')}}
    - DB_POSTGRESDB_HOST=database
    - DB_HOSTNAME=database
    - REDIS_HOSTNAME=redis
  ports: 
    - "{{ services.immich.port }}:2283"
  depends_on:
    - redis
    - database
  restart: unless-stopped
  healthcheck:
    disable: false
{% if services.immich.traefik.enabled | default(false) %}
  labels:
    - traefik.enable=true
    - traefik.http.routers.immich.rule=Host(`{{ services.immich.traefik.host }}.{{ services.immich.traefik.domain }}`)
    - traefik.http.routers.immich.entrypoints=https
    - traefik.http.routers.immich.tls=true
    - traefik.http.routers.immich-http.rule=Host(`{{ services.immich.traefik.host }}.{{ services.immich.traefik.domain }}`)
    - traefik.http.routers.immich-http.entrypoints=http
    - traefik.http.routers.immich-http.middlewares=redirect-to-https
    - traefik.http.middlewares.redirect-to-https.redirectscheme.scheme=https
    - traefik.http.services.immich.loadbalancer.server.port=2283
    - traefik.http.services.immich.loadbalancer.server.scheme=http
{% endif %}
{% if services.immich.networks is defined %}
  networks:
{% for network in services.immich.networks %}
    - {{ network }}
{% endfor %}
{% endif %}
{% if services.immich.dnss is defined %}
  dns:
{% for dns in services.immich.dnss %}
    - {{ dns }}
{% endfor %}
{% endif %}


immich_machine_learning:
  container_name: immich_machine_learning
  # For hardware acceleration, add one of -[armnn, cuda, rocm, openvino, rknn] to the image tag.
  # Example tag: ${IMMICH_VERSION:-release}-openvino
  image: ghcr.io/immich-app/immich-machine-learning:{{ services.immich.version }}
  # extends: # uncomment this section for hardware acceleration - see https://docs.immich.app/features/ml-hardware-acceleration
  #   file: hwaccel.ml.yml
  #   service: cpu # set to one of [armnn, cuda, rocm, openvino, openvino-wsl, rknn] for accelerated inference - use the `-wsl` version for WSL2 where applicable
  volumes:
    - {{ stack_config.data_path }}/immich/model-cache:/cache
  restart: unless-stopped
  healthcheck:
    disable: false
{% if services.immich.networks is defined %}
  networks:
{% for network in services.immich.networks %}
    - {{ network }}
{% endfor %}
{% endif %}
{% if services.immich.dnss is defined %}
  dns:
{% for dns in services.immich.dnss %}
    - {{ dns }}
{% endfor %}
{% endif %}


redis:
  container_name: redis
  image: docker.io/valkey/valkey:8@sha256:81db6d39e1bba3b3ff32bd3a1b19a6d69690f94a3954ec131277b9a26b95b3aa
  healthcheck:
    test: redis-cli ping || exit 1
  restart: unless-stopped
{% if services.immich.networks is defined %}
  networks:
{% for network in services.immich.networks %}
    - {{ network }}
{% endfor %}
{% endif %}
{% if services.immich.dnss is defined %}
  dns:
{% for dns in services.immich.dnss %}
    - {{ dns }}
{% endfor %}
{% endif %}

database:
  container_name: postgres
  image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
  environment:
    POSTGRES_PASSWORD: {{ services.immich.db.password }}
    POSTGRES_USER: {{ services.immich.db.user }}
    POSTGRES_DB: {{ services.immich.db.name | default('immich') }}
    POSTGRES_INITDB_ARGS: '--data-checksums'
    # Uncomment the DB_STORAGE_TYPE: 'HDD' var if your database isn't stored on SSDs
    DB_STORAGE_TYPE: 'HDD'
  volumes:
    # Do not edit the next line. If you want to change the database storage location on your system, edit the value of DB_DATA_LOCATION in the .env file
    - {{ stack_config.data_path }}/immich/database:/var/lib/postgresql/data
  shm_size: 128mb
  restart: unless-stopped
{% if services.immich.networks is defined %}
  networks:
{% for network in services.immich.networks %}
    - {{ network }}
{% endfor %}
{% endif %}
{% if services.immich.dnss is defined %}
  dns:
{% for dns in services.immich.dnss %}
    - {{ dns }}
{% endfor %}
{% endif %}


