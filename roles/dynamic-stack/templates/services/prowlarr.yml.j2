prowlarr:
  image: lscr.io/linuxserver/prowlarr:{{ services.prowlarr.version }}
  container_name: prowlarr
  restart: unless-stopped
  environment:
    - PUID={{ stack_config.user_id }}
    - PGID={{ stack_config.group_id }}
    - TZ={{ stack_config.timezone }}
  volumes:
    - {{ stack_config.config_path }}/prowlarr:/config
  ports:
    - "{{ services.prowlarr.port }}:9696"
{% if services.prowlarr.traefik.enabled | default(false) %}
  labels:
    - traefik.enable=true
    - traefik.http.routers.prowlarr.rule=Host(`{{ services.prowlarr.traefik.host }}.{{ services.prowlarr.traefik.domain }}`)
    - traefik.http.routers.prowlarr.entrypoints=https
    - traefik.http.routers.prowlarr.tls=true
    - traefik.http.routers.prowlarr-http.rule=Host(`{{ services.prowlarr.traefik.host }}.{{ services.prowlarr.traefik.domain }}`)
    - traefik.http.routers.prowlarr-http.entrypoints=http
    - traefik.http.routers.prowlarr-http.middlewares=redirect-to-https
    - traefik.http.middlewares.redirect-to-https.redirectscheme.scheme=https
    - traefik.http.services.prowlarr.loadbalancer.server.port=9696
    - traefik.http.services.prowlarr.loadbalancer.server.scheme=http
{% endif %}
{% if services.prowlarr.networks is defined %}
  networks:
{% for network in services.prowlarr.networks %}
    - {{ network }}
{% endfor %}
{% endif %}

{% if services.prowlarr.dnss is defined %}
  dns:
{% for dns in services.prowlarr.dnss %}
    - {{ dns }}
{% endfor %}
{% endif %}


