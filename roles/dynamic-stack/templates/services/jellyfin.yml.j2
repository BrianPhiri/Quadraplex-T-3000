jellyfin:
  image: lscr.io/linuxserver/jellyfin:{{ services.jellyfin.version }}
  container_name: jellyfin
  restart: unless-stopped
  environment:
    - PUID={{ stack_config.user_id }}
    - PGID={{ stack_config.group_id }}
    - TZ={{ stack_config.timezone }}
  volumes:
    - {{ stack_config.config_path }}/jellyfin:/config
    - {{ stack_config.media_path }}/movies:/data/movies:ro
    - {{ stack_config.media_path }}/tv:/data/tvshows:ro
    - {{ stack_config.media_path }}/music:/data/music:ro
  ports:
    - "{{ services.jellyfin.port }}:8096"
    - 8920:8920
    - 7359:7359/udp
    - 1900:1900/udp
{% if services.jellyfin.traefik.enabled | default(false) %}
  labels:
    - traefik.enable=true
    - traefik.http.routers.jellyfin.rule=Host(`{{ services.jellyfin.traefik.host }}.{{ services.jellyfin.traefik.domain }}`)
    - traefik.http.routers.jellyfin.entrypoints=https
    - traefik.http.routers.jellyfin.tls=true
    - traefik.http.routers.jellyfin-http.rule=Host(`{{ services.jellyfin.traefik.host }}.{{ services.jellyfin.traefik.domain }}`)
    - traefik.http.routers.jellyfin-http.entrypoints=http
    - traefik.http.routers.jellyfin-http.middlewares=redirect-to-https
    - traefik.http.middlewares.redirect-to-https.redirectscheme.scheme=https
    - traefik.http.services.jellyfin.loadbalancer.server.port=8096
    - traefik.http.services.jellyfin.loadbalancer.server.scheme=http
    - "traefik.docker.network=traefik_net"
{% endif %}
{% if services.jellyfin.networks is defined %}
  networks:
{% for network in services.jellyfin.networks %}
    - {{ network }}
{% endfor %}
{% endif %}

{% if services.jellyfin.dnss is defined %}
  dns:
{% for dns in services.jellyfin.dnss %}
    - {{ dns }}
{% endfor %}
{% endif %}


