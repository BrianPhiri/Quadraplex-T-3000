adguardhome:
  image: adguard/adguardhome:{{ services.adguard_home.version }}
  container_name: adguardhome
  restart: unless-stopped
  volumes:
    - {{ stack_config.data_path }}/adguard_home:/opt/adguardhome/work
    - {{ stack_config.config_path }}/adguard_home:/opt/adguardhome/conf
  # NOTE: network_mode: host below means the ports: list here is cosmetic - Docker's
  # port mapping does not apply under host networking. AdGuard actually binds to
  # whatever its own AdGuardHome.yaml (http.address, in the config_path volume above)
  # says, independent of these values. Deploy writes services.adguard_home.http into
  # AdGuardHome.yaml's http.address (tasks/adguard_home.yml) - a mismatch is exactly what
  # caused AdGuard to squat on port 80 and hijack Traefik's http entrypoint (see
  # reports/execution-plan.md, Batch 3).
  ports:
    - "53:53/tcp"
    - "53:53/udp"
    - "{{ services.adguard_home.http }}:80/tcp"
    - "{{ services.adguard_home.https }}:443/tcp"
    - "{{ services.adguard_home.https }}:443/udp"
    - "3000:3000/tcp"
    - "853:853/udp"
  network_mode: host

