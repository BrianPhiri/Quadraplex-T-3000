global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: '{{ stack_name }}'
    environment: '{{ env | default("production") }}'

# Alertmanager configuration
{% if services.alertmanager is defined and services.alertmanager.enabled | default(false) %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - alertmanager:9093
{% endif %}

# Load rules once and periodically evaluate them
rule_files:
  # - "alerts/*.yml"

# Scrape configurations
scrape_configs:
  # Prometheus itself
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

{% if services.node_exporter is defined and services.node_exporter.enabled | default(false) %}
  # Node Exporter
  - job_name: 'node'
    static_configs:
      - targets: ['node_exporter:9100']
        labels:
          instance: '{{ inventory_hostname }}'
{% endif %}

{% if services.cadvisor is defined and services.cadvisor.enabled | default(false) %}
  # cAdvisor (Docker container metrics)
  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']
        labels:
          instance: '{{ inventory_hostname }}'
{% endif %}

{% if services.grafana is defined and services.grafana.enabled | default(false) %}
  # Grafana
  - job_name: 'grafana'
    static_configs:
      - targets: ['grafana:3000']
{% endif %}
