#!/bin/bash
# Weekly ClamAV scan, run from root's crontab. Managed by Ansible (roles/clamav).
# Gotify is notified only when something is found or the scan fails; a clean scan just logs.
LOG_FILE={{ clamav_log_file | quote }}
SCAN_DIRS=({% for dir in clamav_scan_dirs %}{{ dir | quote }} {% endfor %})
EXCLUDE_OPTS=({% for dir in clamav_exclude_dirs %}--exclude-dir={{ dir | quote }} {% endfor %})
{% if clamav_gotify_enabled | bool %}
GOTIFY_URL={{ clamav_gotify_url | quote }}
GOTIFY_TOKEN={{ clamav_gotify_token | quote }}
{% else %}
GOTIFY_URL=""
GOTIFY_TOKEN=""
{% endif %}

mkdir -p "$(dirname "$LOG_FILE")"
log() { echo "$*" >> "$LOG_FILE"; }

# Form fields rather than hand-built JSON, and --form-string so that file names
# containing quotes, newlines, ';' or a leading '@' are sent literally.
notify() {
  logger -t clamav-scan -p user.crit "$1" 2>/dev/null
  if [ -z "$GOTIFY_URL" ] || [ -z "$GOTIFY_TOKEN" ]; then
    log "Gotify not configured, notification not sent: $1"
    return 0
  fi
  curl -sS -f -m 15 -o /dev/null -X POST "${GOTIFY_URL}/message" -H "X-Gotify-Key: ${GOTIFY_TOKEN}" \
    --form-string "title=$1" --form-string "message=$2" --form-string "priority=$3" >> "$LOG_FILE" 2>&1 \
    || log "Gotify notification failed: $1"
}

# clamscan fails the whole run on a path that doesn't exist, so skip those.
DIRS=()
for dir in "${SCAN_DIRS[@]}"; do
  if [ -e "$dir" ]; then DIRS+=("$dir"); else log "Skipping missing directory: $dir"; fi
done

OUT=$(mktemp)
trap 'rm -f "$OUT"' EXIT
START_TIME=$(date +%s)
log "=== ClamAV Scan Started: $(date '+%Y-%m-%d %H:%M:%S') ==="
log "Scanning: ${DIRS[*]}"

if [ -z "${DIRS[*]}" ]; then
  echo "ERROR: none of the configured scan directories exist" > "$OUT"
  SCAN_RESULT=2
else
  # clamscan exits 0 = clean, 1 = infected file(s) found, anything else = error
  nice -n 19 ionice -c 3 clamscan -r -i "${EXCLUDE_OPTS[@]}" "${DIRS[@]}" > "$OUT" 2>&1
  SCAN_RESULT=$?
fi
cat "$OUT" >> "$LOG_FILE"
DURATION_MIN=$(( ($(date +%s) - START_TIME) / 60 ))

if [ $SCAN_RESULT -eq 1 ]; then
  notify "ClamAV: $(grep -c ' FOUND$' "$OUT") infected file(s) on $(hostname)" \
    "$(grep ' FOUND$' "$OUT" | head -10)
Full log: ${LOG_FILE}" 10
elif [ $SCAN_RESULT -ne 0 ]; then
  notify "ClamAV scan error on $(hostname) (exit ${SCAN_RESULT})" \
    "$(grep -i -m 10 -E 'error|warning' "$OUT" || tail -5 "$OUT")
Full log: ${LOG_FILE}" 8
fi

log "=== ClamAV Scan Finished: $(date '+%Y-%m-%d %H:%M:%S') (exit ${SCAN_RESULT}, ${DURATION_MIN} min) ==="
log ""
exit $SCAN_RESULT
