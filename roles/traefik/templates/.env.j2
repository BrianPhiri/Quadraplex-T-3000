# Cloudflare API Token
CF_DNS_API_TOKEN={{ proxy_services.traefik.cloudflare.token }}

# Domain configuration
DOMAIN={{ domain | default(default_domain) }}

# Traefik Dashboard
TRAEFIK_DASHBOARD_HOST={{ proxy_services.traefik.dashboard.url | default('traefik.' ~ domain) }}
TRAEFIK_DASHBOARD_CREDENTIALS={{ proxy_services.traefik.dashboard.credentials }}
