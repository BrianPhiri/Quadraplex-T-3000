global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: '{{ stack_name }}'
    environment: '{{ env | default("production") }}'

# Alertmanager configuration
{% if 'alertmanager' in services %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - alertmanager:9093
{% endif %}

# Load rules once and periodically evaluate them
rule_files:
  # - "alerts/*.yml"

# Scrape configurations
scrape_configs:
  # Prometheus itself
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

{% if 'node_exporter' in services %}
  # Node Exporter
  - job_name: 'node_exporter'
    static_configs:
      - targets: ['node_exporter:9100']
        labels:
          instance: '{{ inventory_hostname }}'
{% endif %}

{% if 'cadvisor' in services %}
  # cAdvisor (Docker container metrics)
  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']
        labels:
          instance: '{{ inventory_hostname }}'
{% endif %}

{% if vault_hive_metrics_password is defined %}
  # MyHive, the online server: over NetBird (extra_hosts on the prometheus service), behind Caddy's basic auth
  - job_name: 'hive-node'
    scheme: https
    basic_auth: { username: prometheus, password: '{{ vault_hive_metrics_password }}' }
    static_configs:
      - targets: ['node.hive.brianphiri.digital']
        labels:
          instance: 'hive'

  - job_name: 'hive-cadvisor'
    scheme: https
    basic_auth: { username: prometheus, password: '{{ vault_hive_metrics_password }}' }
    static_configs:
      - targets: ['cadvisor.hive.brianphiri.digital']
        labels:
          instance: 'hive'

  # ZedCloud's stage A server (BrianPhiri/ZedCloud ansible/): node_exporter on its NetBird IP only, same
  # prometheus user and password as hive. Plain HTTP inside NetBird's WireGuard tunnel.
  - job_name: 'zedcloud-node'
    basic_auth: { username: prometheus, password: '{{ vault_hive_metrics_password }}' }
    static_configs:
      - targets: ['100.80.138.178:9100']
        labels:
          instance: 'zedcloud'
{% endif %}

{% if 'grafana' in services %}
  # Grafana
  - job_name: 'grafana'
    static_configs:
      - targets: ['grafana:3000']
{% endif %}

{% if 'loki' in services %}
  # Loki
  - job_name: 'loki'
    static_configs:
      - targets: ['loki:3100']
        labels:
          instance: '{{ inventory_hostname }}'
{% endif %}
